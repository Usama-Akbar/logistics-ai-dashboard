# Required for the "Ask the data" tab (free key: https://console.groq.com/keys).
# The dashboard and forecast tabs work without it.
GROQ_API_KEY=

# Optional
# GROQ_MODEL=openai/gpt-oss-120b   # Groq model used to interpret questions (must support tool calling)
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b   # tried in order when the primary model is rate-limited
# AI_EFFORT=low                    # reasoning effort for gpt-oss models: low | medium | high
# ASK_RATE_LIMIT=20                # questions per IP per minute (per server instance)
